# Auth0 Next.js SDK v4 — required
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=

# Optional — only if you call a protected API with an access token
AUTH0_AUDIENCE=
AUTH0_SCOPE=

# Optional — only needed for resendVerificationEmail() (Management API)
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
