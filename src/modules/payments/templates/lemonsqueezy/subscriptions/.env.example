# Lemon Squeezy — One-time Payments module
# Settings > API in your Lemon Squeezy dashboard
LEMONSQUEEZY_API_KEY=

# Settings > Stores (the numeric store id)
LEMONSQUEEZY_STORE_ID=

# Settings > Webhooks > (your webhook) > Signing secret
LEMONSQUEEZY_WEBHOOK_SECRET=

# Lemon Squeezy — Subscriptions module
# A separate webhook registered in Settings > Webhooks, subscribed only to
# subscription lifecycle events (see SUBSCRIPTIONS_SETUP.md)
LEMONSQUEEZY_SUBSCRIPTIONS_WEBHOOK_SECRET=
