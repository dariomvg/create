# Stripe One-time Payments module — environment variables
# Get these from https://dashboard.stripe.com/apikeys and
# https://dashboard.stripe.com/webhooks

# Server-side secret key (never expose to the client)
STRIPE_SECRET_KEY=

# Client-side publishable key (safe to expose, used by lib/stripe/client.ts)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Signing secret for the one-time payments webhook endpoint (from the
# webhook's settings page, or from `stripe listen` when testing locally
# with the Stripe CLI)
STRIPE_WEBHOOK_SECRET=

# Signing secret for the separate Billing webhook endpoint
# (app/api/webhooks/stripe-billing/route.ts) — this is a different
# endpoint in the Stripe Dashboard, so it has its own secret.
STRIPE_BILLING_WEBHOOK_SECRET=
