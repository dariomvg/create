# Mercado Pago One-time Payments module — environment variables
# See SETUP.md for where to find each value.

# Secret access token for your Mercado Pago application (server-side only).
# Use the TEST token while developing, the production token when you go live.
MERCADOPAGO_ACCESS_TOKEN=

# Secret key used to verify the x-signature header on incoming webhooks.
MERCADOPAGO_WEBHOOK_SECRET=

# Your app's public base URL, used to build the Checkout Pro back_urls
# (success/failure/pending) passed when creating a preference.
NEXT_PUBLIC_APP_URL=
