# Mercado Pago Subscriptions module — environment variables
# See SETUP.md for where to find each value.

# Secret access token for your Mercado Pago application (server-side only).
# Same token used by the one-time payments module — you likely already have this.
MERCADOPAGO_ACCESS_TOKEN=

# Secret key used to verify the x-signature header on incoming subscription
# webhooks. Separate from the one-time payments webhook secret — this module
# has its own webhook URL and its own signature secret in the dashboard.
MERCADOPAGO_SUBSCRIPTIONS_WEBHOOK_SECRET=

# Your app's public base URL, used to build the back_url passed when creating
# a subscription.
NEXT_PUBLIC_APP_URL=
