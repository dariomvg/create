{
  "name": "@dariomvg/create",
  "version": "0.1.1",
  "description": "CLI | add Auth - AI - Payments - Email to Next.js projects",
  "type": "module",
  "bin": {
    "create": "./bin/create.js"
  },
  "files": [
    "dist",
    "bin",
    "src/modules/**/templates/**",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
  "type": "git",
  "url": "https://github.com/dariomvg/create.git"
},
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "nextjs",
    "cli",
    "scaffolding",
    "auth",
    "payments",
    "email",
    "ai"
  ],
  "homepage": "https://www.formaui.site",
  "author": {
    "name": "Dario",
    "url": "https://github.com/dariomvg"
  },
  "license": "MIT",
  "packageManager": "bun@1.1.0",
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "commander": "^12.1.0",
    "execa": "^9.4.0",
    "fs-extra": "^11.2.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.7.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
